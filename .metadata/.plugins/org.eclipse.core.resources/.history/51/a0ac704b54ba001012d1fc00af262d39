package com.azienda.esempioRestClient.bin;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;
import org.springframework.web.client.RestTemplate;

@SpringBootApplication(scanBasePackages = "com.azienda.esempioRestClient.ui" )
public class EsempioRestClientApplication {

	public static void main(String[] args) {
		try {
			SpringApplication.run(EsempioRestClientApplication.class, args);
		} catch (Exception e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
	}
	@Bean
	public RestTemplate restTemplate() {
		return new RestTemplate();
	}
}
