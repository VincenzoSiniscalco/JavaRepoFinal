package com.azienda.esempioRest.controller;

import java.util.ArrayList;
import java.util.List;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseStatus;
import org.springframework.web.bind.annotation.RestController;

import com.azienda.esempioRest.model.Persona;

@RestController
@RequestMapping(path = "/rest",produces = {"application/json"})
@CrossOrigin(origins = {"*"})
public class PersonaRestController {
	
	private List<Persona> persone;
	
	public PersonaRestController() {
		persone= new ArrayList<Persona>();
		persone.add(new Persona(1,"Mario","Rossi"));
		persone.add(new Persona(2,"Claudio","Verdi"));
		persone.add(new Persona(3,"Elena","Bianchi"));
	}
	
	@GetMapping("/elenco")
	public List<Persona> elenco(){
		return persone;
	}
	
	@GetMapping("/get/{id}")
	public ResponseEntity<Persona> getById(@PathVariable("id") Integer id){
		try {
			Persona p=ricercaById(id);
			
			HttpStatus httpStatus= p!=null ? HttpStatus.OK : HttpStatus.NOT_FOUND;
			return new ResponseEntity<Persona>(p, httpStatus);
			
		} catch (Exception e) {
			e.printStackTrace();
			return new ResponseEntity<Persona>(HttpStatus.INTERNAL_SERVER_ERROR);
		}
	}
	
	@PostMapping(path = "/inserisci",consumes = {"application/json"})
	@ResponseStatus(HttpStatus.CREATED)
	public Persona inserisci(@RequestBody Persona p) {
		persone.add(p);
		return p;
	}
	
	@PostMapping(path="/inserisci2",consumes = {"application/json"})
	public ResponseEntity<Persona> inserisci2(@RequestBody Persona p){
		try {
			Persona per=ricercaById(p.getId());
			
			HttpStatus httpStatus= p!=null ? HttpStatus.OK : HttpStatus.NOT_FOUND;
			return new ResponseEntity<Persona>(p, httpStatus);
			
		} catch (Exception e) {
			e.printStackTrace();
			return new ResponseEntity<Persona>(HttpStatus.INTERNAL_SERVER_ERROR);
		}
	}
	private Persona ricercaById(Integer id) {
		Persona p=null;
		for(Persona per:persone) {
			if(per.getId().equals(id)) {
				p=per;
				break;
			}
		}
		return p;
	}
}
