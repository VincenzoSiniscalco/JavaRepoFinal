package com.azienda.esempioRest.controller;

import java.util.ArrayList;
import java.util.List;

import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.azienda.esempioRest.model.Persona;

@RestController
@RequestMapping(path = "/rest",produces = {"application/json"})
@CrossOrigin(origins = {"*"})
public class PersonaRestController {
	
	private List<Persona> persone;
	
	public PersonaRestController() {
		persone= new ArrayList<Persona>();
		persone.add(new Persona(1,"Mario","Rossi"));
		persone.add(new Persona(2,"Claudio","Verdi"));
		persone.add(new Persona(3,"Elena","Bianchi"));
	}
}
