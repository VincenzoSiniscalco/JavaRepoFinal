	public void insert(String citta,String via,Integer civico) throws IsStringException {
		Indirizzo ind = null;
		if(isString(citta)&&isString(via)&&isInt(civico)) {
			ind= new Indirizzo(citta,via,civico);
		}
		if(indirizzoAlreadyExists(citta,via,civico)) {
			throw new IllegalArgumentException("L'indirizzo è già presente nel database!");
		}
		
		
		indirizzoRepository.save(ind);
	}
	//implementare metodo controllo campi qui e nel controller
	public List<Indirizzo> read() {
		return indirizzoRepository.findAll();
	}
	public List<Indirizzo> readByCittà(String citta) {
		return indirizzoRepository.findByCitta(citta);
	}
	public List<Indirizzo> readByCittàAndVia(String citta,String via) {
		return indirizzoRepository.findByCittaAndVia(citta,via);
	}
	public Indirizzo update(String citta,String via,Integer civico,String cittaNew,String viaNew,Integer civicoNew) {
		Indirizzo ind= indirizzoRepository.findByCittaAndViaAndCivico(citta,via,civico); //controllo se utente aggiornato esiste con alreadyExists
		if(ind==null) {
			throw new IndirizzoNullException("L'indirizzo non esiste!", null)
		}
		ind.setCitta(cittaNew);															 //controllo se ind ==null
		ind.setVia(viaNew);															     //controllo sui campi
		ind.setCivico(civicoNew);
		indirizzoRepository.save(ind);
		return ind;
	}
	public Indirizzo updateParziale(String citta,String via,Integer civico,Integer id) {
		Indirizzo ind= indirizzoRepository.findById(id).orElse(null); //controllo se utente aggiornato esiste con alreadyExists
		ind.setCitta(citta);															 //controllo se ind ==null
		ind.setVia(via);															     //controllo sui campi
		ind.setCivico(civico);
		indirizzoRepository.save(ind);
		return ind;
	}
	
	public void remove(String citta,String via,Integer civico) {						//controllo sui campi
		Indirizzo ind= indirizzoRepository.findByCittaAndViaAndCivico(citta,via,civico);//controllo se utente aggiornato esiste con alreadyExists
		Integer idRemove=ind.getId();													//controllo se ind ==null
		indirizzoRepository.deleteById(idRemove);
	}
	private boolean indirizzoAlreadyExists(String citta,String via,Integer civico) {
		Indirizzo ind= indirizzoRepository.findByCittaAndViaAndCivico(citta,via,civico);
		return ind!=null;
	}
	private boolean isString(String s) throws IsStringException {
		if(s.isEmpty()||s.isBlank()) {
			throw new IsStringException("Non hai inserito una stringa valida!",null);
		}return true;
	}
	private boolean isInt(Integer i) {
		return i instanceof Integer;
	}
}
