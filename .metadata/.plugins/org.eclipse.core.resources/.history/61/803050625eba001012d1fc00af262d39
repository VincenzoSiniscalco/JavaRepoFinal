package com.azienda.esempioRestClient.ui;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Component;
import org.springframework.web.client.HttpClientErrorException;
import org.springframework.web.client.HttpServerErrorException;
import org.springframework.web.client.RestTemplate;

@Component
public class TestClient {
	
	@Autowired
	private RestTemplate restTemplate;
	
	private final String SERVER_URL="http://localhost:8080/rest";
	
	public void testGetById(Integer id) {
		try {
			ResponseEntity<PersonaDTO> responseEntity = restTemplate.getForEntity(SERVER_URL+"/get/{id}", PersonaDTO.class, id);
			System.out.println(responseEntity.getStatusCode());
			System.out.println(responseEntity.getBody());
		} catch (HttpClientErrorException e) {
			e.printStackTrace();
		} catch (HttpServerErrorException e) {
			e.printStackTrace();
		} catch (Exception e) {
			e.printStackTrace();
		}
	}

	public void testPost(PersonaDTO p) {
		try {
			ResponseEntity<PersonaDTO> responseEntity = restTemplate.postForEntity(SERVER_URL+"/inserisci2",p, PersonaDTO.class);
			System.out.println(responseEntity.getStatusCode());
			System.out.println(responseEntity.getBody());
		} catch (HttpClientErrorException e) {
			e.printStackTrace();
		} catch (HttpServerErrorException e) {
			e.printStackTrace();
		} catch (Exception e) {
			e.printStackTrace();
		}
	}
	public void testPut(PersonaDTO p) {
		try {
			restTemplate.put(SERVER_URL+"/aggiornaTotale",p);
			
		} catch (HttpClientErrorException e) {
			e.printStackTrace();
		} catch (HttpServerErrorException e) {
			e.printStackTrace();
		} catch (Exception e) {
			e.printStackTrace();
		}
	}
	public void testPatch(PersonaDTO p) {
		try {
			PersonaDTO result=restTemplate.patchForObject(SERVER_URL+"/aggiornaParziale",p,PersonaDTO.class);
			
		} catch (HttpClientErrorException e) {
			e.printStackTrace();
		} catch (HttpServerErrorException e) {
			e.printStackTrace();
		} catch (Exception e) {
			e.printStackTrace();
		}
	}
	
}
