	public void insert(String citta,String via,Integer civico) throws IsStringException, NotIntegerException,IndirizzoAlreadyExistException {
		Indirizzo ind = null;
		
		if(isString(citta)&&isString(via)&&isInt(civico)) {
			ind= new Indirizzo(citta,via,civico);
		}
		if(indirizzoAlreadyExists(citta, via, civico)) {
			throw new IndirizzoAlreadyExistException("L'indirizzo già esiste!", null);
		}
		indirizzoRepository.save(ind);
	}

	public List<Indirizzo> read() {
		return indirizzoRepository.findAll();
	}
	public List<Indirizzo> readByCittà(String citta) {
		return indirizzoRepository.findByCitta(citta);
	}
	public List<Indirizzo> readByCittàAndVia(String citta,String via) {
		return indirizzoRepository.findByCittaAndVia(citta,via);
	}
	public Indirizzo update(String citta,String via,Integer civico,String cittaNew,String viaNew,Integer civicoNew) throws IndirizzoNullException, IndirizzoAlreadyExistException, IndirizzoNotExistException {
		Indirizzo ind= indirizzoRepository.findByCittaAndViaAndCivico(citta,via,civico); 
		if(ind==null) {
			throw new IndirizzoNullException("L'indirizzo non esiste!", null);
		}
		if(indirizzoAlreadyExists(cittaNew, viaNew, civicoNew)) {
			throw new IndirizzoAlreadyExistException("L'indirizzo che stai provando ad inserire al posto del vecchio già esiste nel database!", null);
		}
		if(indirizzoNotExists(citta, via, civico)) {
			try {
				isString(cittaNew);
				isString(viaNew);
				ind.setCitta(cittaNew);															 
				ind.setVia(viaNew);
			} catch (IsStringException e) {
				e.printStackTrace();
			}															     
			try {
				isInt(civicoNew);
				ind.setCivico(civicoNew);
			} catch (NotIntegerException e) {
				e.printStackTrace();
			}
			indirizzoRepository.save(ind);
			
		}return ind;
		
	}
	public Indirizzo updateParziale(String citta,String via,Integer civico,Integer id) throws IndirizzoNullException, IndirizzoNotExistException, IndirizzoAlreadyExistException {
		Indirizzo ind= indirizzoRepository.findById(id).orElse(null); 
		if(ind==null&&id==null) {
			throw new IndirizzoNullException("L'indirizzo non esiste!", null);
		}	
		if(indirizzoAlreadyExists(citta, via, civico)) {
			try {
				isString(citta);
				isString(via);
				ind.setCitta(citta);															 
				ind.setVia(via);
			} catch (IsStringException e) {
				e.printStackTrace();
			}															     
			try {
				isInt(civico);
				ind.setCivico(civico);
			} catch (NotIntegerException e) {
				e.printStackTrace();
			}
			indirizzoRepository.save(ind);
			return ind;
		}else {
			throw new IndirizzoNotExistException("L'indirizzo "+citta+" "+via+" "+" "+civico+" non esiste nel database!", null);
		}
		
	}
	
	public void remove(String citta,String via,Integer civico) throws IndirizzoNullException, IndirizzoAlreadyExistException, IndirizzoNotExistException {						
		Indirizzo ind= indirizzoRepository.findByCittaAndViaAndCivico(citta,via,civico); 
		if(ind==null) {
			throw new IndirizzoNullException("L'indirizzo non esiste!", null);
		}	
		if(indirizzoAlreadyExists(citta, via, civico)) {
			try {
				isString(citta);
				isString(via);
			} catch (IsStringException e) {
				e.printStackTrace();
			}															
			try {
				isInt(civico);
			} catch (NotIntegerException e) {
				e.printStackTrace();
			}
			Integer idRemove=ind.getId();													
			indirizzoRepository.deleteById(idRemove);
			}else {
				throw new IndirizzoNotExistException("L'indirizzo "+citta+" "+via+" "+" "+civico+" non esiste nel database!", null);
			}
		
	}
	private boolean indirizzoAlreadyExists(String citta,String via,Integer civico) throws IndirizzoAlreadyExistException {
		Indirizzo ind= indirizzoRepository.findByCittaAndViaAndCivico(citta,via,civico);
		if(ind!=null) {
			throw new IndirizzoAlreadyExistException("L'indirizzo esiste già nel database!",null);
		}
		return true;
	}
	private boolean indirizzoNotExists(String citta,String via,Integer civico) throws IndirizzoNotExistException {
		Indirizzo ind= indirizzoRepository.findByCittaAndViaAndCivico(citta,via,civico);
		if(ind==null) {
			throw new IndirizzoNotExistException("L'indirizzo esiste già nel database!",null);
		}
		return true;
	}
	private boolean isString(String s) throws IsStringException {
		if(s.isEmpty()||s.isBlank()) {
			throw new IsStringException("Non hai inserito una stringa valida!",null);
		}return true;
	}
	private boolean isInt(Integer i) throws NotIntegerException {
		if(i==null) {
			throw new NotIntegerException("Il campo non contiene un numero.",null);
		}
		return true;
	}
}
