package it.itconsulting.esercizi.ui;

import java.util.Scanner;

public class TestMinMax {

	public static void main(String[] args) {
		int scelta;
		Scanner sc= new Scanner(System.in);
		do {
		System.out.println("Inserire il primo numero intero: ");
		int num1= sc.nextInt();
		
		System.out.println("Inserire il secondo numero intero: ");
		int num2= sc.nextInt();
		
		System.out.println("Inserire il terzo numero intero: ");
		int num3= sc.nextInt();
		
		System.out.println("Calcolo del min/max: inserire true/false: ");
		boolean flag=sc.nextBoolean();
		
		int res=minMax(num1,num2,num3,flag);
		
		if(flag) {
			System.out.println("Il minimo è: " +res);
			}else {
			System.out.println("Il massimo è: "+res);
			}
		
		System.out.println("Se si vuole continuare inputare numero diverso da zero.");
		scelta=sc.nextInt();
		
		}while(scelta!=0);
		
		sc.close();
	}
	static int minMax(int num1, int num2, int num3, boolean b) {
		if(b==true) {
			if(num1<num2) {
				if(num1<num3) {
					return num1;
				}else {
					return num3;
				}
			}else if(num2<num3){
					return num2;
			}else {
				return num3;
			}
				
		}else {
			if(num1>num2) {
		
				if(num1>num3) {
					return num1;
				}else {
					return num3;
				}
			}else if(num2>num3){
				return num2;
		}else {
			return num3;
		}
	}
	}
}
	

