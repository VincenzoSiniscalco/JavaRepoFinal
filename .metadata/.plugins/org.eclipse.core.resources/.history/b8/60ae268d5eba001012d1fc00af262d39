package com.azienda.esempioRestClient.bin;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.ConfigurableApplicationContext;
import org.springframework.context.annotation.Bean;
import org.springframework.http.client.HttpComponentsClientHttpRequestFactory;
import org.springframework.web.client.RestTemplate;

import com.azienda.esempioRestClient.ui.PersonaDTO;
import com.azienda.esempioRestClient.ui.TestClient;

@SpringBootApplication(scanBasePackages = "com.azienda.esempioRestClient.ui" )
public class EsempioRestClientApplication {

	public static void main(String[] args) {
		try (ConfigurableApplicationContext context=SpringApplication.run(EsempioRestClientApplication.class, args) ){
			TestClient client= context.getBean("testClient",TestClient.class);
//			client.testGetById(3);
//			client.testGetById(4);
//			client.testPost(new PersonaDTO(5,"Valerio","Gialli"));
//			client.testPut(new PersonaDTO(1,"Giovanni",null));
//			client.testPut(new PersonaDTO(15,"Giovanni",null));
			client.testPatch(new PersonaDTO(1,null,"Arancioni"));
			System.out.println("Programma terminato.");
		} catch (Exception e) {
			e.printStackTrace();
		}
	}
	@Bean
	public RestTemplate restTemplate() {
		RestTemplate restTemplate= new RestTemplate();
		HttpComponentsClientHttpRequestFactory factory= new HttpComponentsClientHttpRequestFactory();
		restTemplate.setRequestFactory(factory);
		return restTemplate;
	}
}
