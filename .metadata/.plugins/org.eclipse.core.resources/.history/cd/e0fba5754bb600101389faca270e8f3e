package com.azienda.esempioMvc3.bin;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.boot.autoconfigure.domain.EntityScan;
import org.springframework.context.ConfigurableApplicationContext;
import org.springframework.data.jpa.repository.config.EnableJpaRepositories;

import com.azienda.esempioMvc3.service.ServiceIndirizzo;

@SpringBootApplication(scanBasePackages = {"com.azienda.esempioMvc3.service","com.azienda.esempioMvc3.controller"})
@EntityScan(basePackages = {"com.azienda.esempioMvc3.model"})
@EnableJpaRepositories(basePackages = {"com.azienda.esempioMvc3.repository"})
public class EsempioMvc3Application {

	public static void main(String[] args) {
		try {
			SpringApplication.run(EsempioMvc3Application.class, args);
		     // Avvio dell'applicazione e recupero del contesto Spring
            ConfigurableApplicationContext context = SpringApplication.run(EsempioMvc3Application.class, args);

            // Recupero del bean ServiceIndirizzo dal contesto
            ServiceIndirizzo service = context.getBean(ServiceIndirizzo.class);

            // Popolamento del database
            service.riempiDb();
		} catch (Exception e) {
			e.printStackTrace();
		}
	}

}
