package it.itconsulting.esercizi.ui;

import java.util.Scanner;

public class TestBancomat {

	public static void main(String[] args) {
		int saldoConto,prelievo,versamento;
		Scanner sc=new Scanner(System.in);
		int flag;
		do {
		System.out.println("Immetti il saldo iniziale del conto corrente: ");
		saldoConto=sc.nextInt();
		flag=controllo(sc);
		switch(flag) {
		case 1:{ //prelievo
			System.out.println("Quanto vuoi prelevare?");
			prelievo=sc.nextInt();
			if(prelievo>saldoConto) {
				System.err.println("Non hai abbastanza soldi nel conto!");
			}else if(prelievo<0) {
				System.err.println("Devi immettere un numero positivo!");
			}else {
				saldoConto-=prelievo;
				System.out.println("Il tuo nuovo saldo sul conto è: "+saldoConto);
			}
			break;
		}
		case 2:{//versamento
			System.out.println("Quanto vorresti versare sul conto?");
			versamento=sc.nextInt();
			if(versamento<0) {
				System.err.println("Devi immettere un importo positivo!");
			}else {
				saldoConto+=versamento;
				System.out.println("Il tuo nuovo saldo sul conto è: "+saldoConto);
			}
			break;
		}
		case 0:{
			System.out.println("Esco dal programma");
			break;
			}
		}
	}while(flag!=0);
		
		
		sc.close();
	}
	static int controllo(Scanner sc) {
		int scelta;
		do {
			System.out.println("Selezionare un operazione: ");
			System.out.println("1- Preleva ");
			System.out.println("2- Versa ");
			System.out.println("0- Esci");
			scelta= sc.nextInt();
		}while(scelta<0||scelta>2);
		return scelta;
	}
	
	
}
