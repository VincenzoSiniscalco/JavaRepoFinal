package it.itconsulting.ClassObject.ui;

import it.itconsulting.ClassObject.model.Automobile;
import it.itconsulting.ClassObject.model.Fabbrica;
import it.itconsulting.ClassObject.model.Indirizzo;

public class ChiamanteAutomobile {
	public static void main(String[] args) {
		
		Indirizzo i1= new Indirizzo("Italia","Modena","Via Roma",10236);
		Fabbrica f1=new Fabbrica("Ferrari",i1);
		for(int i=0;i<5;i++) {
			Automobile a= new Automobile("F488", "Ferrari", "AB"+i+i+i+"CD",4500,f1);
			System.out.println(a.infoAutomobile());
		}
		System.out.println("La fabbrica "+f1.infoFabbrica()+ " ha prodotto "+f1.getAutoProdotte()+ " automobili.");
		
		Indirizzo i2= new Indirizzo("Germania","Berlino","Via Dusseldorf",45223);
		Fabbrica f2=new Fabbrica("Mercedes",i2);
		for(int i=0;i<3;i++) {
			Automobile a= new Automobile("S", "Mercedes", "EF"+i+i+i+"GH",3000,f2);
			System.out.println(a.infoAutomobile());
		}
		System.out.println(f2.getAutoProdotte());		
	}
}
