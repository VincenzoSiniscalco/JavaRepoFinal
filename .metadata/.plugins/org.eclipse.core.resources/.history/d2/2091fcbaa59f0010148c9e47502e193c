package it.itconsulting.ClassObject.ui;

import java.util.Scanner;

import it.itconsulting.ClassObject.model.Libro;

public class TestLibro {

	public static void main(String[] args) {
		
		Scanner sc= new Scanner(System.in);
		
		int scelta = 0;
		do {
		System.out.println("Inserire i dettagli del libro (Titolo , autore , prezzo, numero pagine): ");
		
		Libro l= new Libro(sc.nextLine(), sc.nextLine(), sc.nextFloat(), sc.nextInt());
		l.stampaInfo();
		
		System.out.println("Immettere l'aumento di prezzo da applicare al libro "+ l.getTitolo());
		
		l.incrementaPrezzo(sc);
		
		l.stampaInfo();
		
		System.out.println("Se si vuole continuare ad usare il programma, digitare un numero diverso da zero.");
		scelta= sc.nextInt();
		}while(scelta!=0);
		sc.close();
	}
	public static void Libro(Scanner sc) { //costruttore per parametri da console
		System.out.println("Inserire le caratteristiche del libro(titolo, autore, prezzo, numero pagine): ");
		if(sc!=null) {
		Libro.setTitolo(sc.nextLine());
		Libro.setAutore(sc.nextLine());
		Libro.setPrezzo(sc.nextFloat());
		Libro.setNumeroPagine(sc.nextInt());
		}else {
			System.err.println(stampaErrore());
		}
	}
	public static void setTitoloS(String titolo) {
		Libro.titolo = titolo;
	}
	public static void setAutore(String autore) {
		Libro.autore = autore;
	}
	public void setPrezzo(String titolo) {
		Libro.prezzo = titolo;
	}
	public void setNumeroPagine(String titolo) {
		Libro.numeroPagine = titolo;
	}

}
