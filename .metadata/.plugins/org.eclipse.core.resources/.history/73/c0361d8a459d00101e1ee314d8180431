package it.itconsulting.esercizi.ui;

import java.util.Scanner;

public class TestDivisione {

	public static void main(String[] args) {
		Scanner sc= new Scanner(System.in);
		double num1;
		do {
		System.out.println("Inserisci il primo numero: ");
		num1=sc.nextDouble();
		}while(num1<0);
		
		double num2;
		do {
		System.out.println("Inserisci il secondo numero: ");
		num2=sc.nextDouble();
		}while(num2==0);
		
		double result= divisione(num1,num2);
		System.out.println("Il risultato della divisione è: "+ result);
		
		sc.close();
	}
	static double divisione(double a,double b) {
		double res;
		if(b!=0) {
			res= a/b;
			return res;
		}else {
			System.err.println("Errore, il secondo numero dev'essere diverso da zero!");
			return 0;
		}
		
	}
}
