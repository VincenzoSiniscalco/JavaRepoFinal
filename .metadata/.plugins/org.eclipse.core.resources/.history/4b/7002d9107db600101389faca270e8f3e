	public void insert(String citta,String via,Integer civico) throws IsStringException, NotIntegerException,IndirizzoAlreadyExistException {
		Indirizzo ind = null;
		isString(citta);
		isString(via);
		isInt(civico);
	
		ind= indirizzoRepository.findByCittaAndViaAndCivico(citta, via, civico);
		if(ind!=null) {
			throw new IndirizzoAlreadyExistException("L'indirizzo già esiste!", null);
		}
		ind=new Indirizzo(citta,via,civico);
		
		indirizzoRepository.save(ind);
	}

	public List<Indirizzo> read() {
		return indirizzoRepository.findAll();
	}
	public List<Indirizzo> readByCittà(String citta) {
		return indirizzoRepository.findByCitta(citta);
	}
	public List<Indirizzo> readByCittàAndVia(String citta,String via) {
		return indirizzoRepository.findByCittaAndVia(citta,via);
	}
	public Indirizzo update(String citta,String via,Integer civico,String cittaNew,String viaNew,Integer civicoNew) throws IndirizzoNullException, IndirizzoAlreadyExistException, IndirizzoNotExistException, NotIntegerException, IsStringException {

		isString(cittaNew);
		isString(viaNew);
		isInt(civicoNew);

		Indirizzo ind = indirizzoRepository.findByCittaAndViaAndCivico(cittaNew, viaNew, civicoNew);
		if(ind!=null) {
			throw new IndirizzoAlreadyExistException("L'indirizzo che stai provando ad inserire al posto del vecchio già esiste nel database!", null);
		}
		ind = indirizzoRepository.findByCittaAndViaAndCivico(citta, via, civico);
		if(ind==null) {
			throw new IndirizzoNotExistException("L'indirizzo che stai provando ad inserire al posto del vecchio non esiste nel database!", null);
		}
		ind.setCitta(cittaNew);															 
		ind.setVia(viaNew);
		ind.setCivico(civicoNew);
		indirizzoRepository.save(ind);

		return ind;
	}
	public Indirizzo updateParziale(String cittaNew,String viaNew,Integer civicoNew,Integer id) throws IsStringException, NotIntegerException, IndirizzoNotExistException, IndirizzoAlreadyExistException {
		isString(cittaNew);
		isString(viaNew);
		isInt(civicoNew);

		Indirizzo ind= indirizzoRepository.findById(id).orElse(null); 
		if(ind==null) {
			throw new IndirizzoNotExistException("L'indirizzo non esiste!", null);
		}	
		Indirizzo ind2=indirizzoRepository.findByCittaAndViaAndCivico(cittaNew, viaNew, civicoNew);
		if(ind2!=null) {
			throw new IndirizzoAlreadyExistException("L'indirizzo che stai provando ad inserire al posto del vecchio già esiste nel database!", null);
		}
		ind.setCitta(cittaNew);														 
		ind.setVia(viaNew);
		ind.setCivico(civicoNew);
		indirizzoRepository.save(ind);
		return ind;
	}

	public void remove(String citta,String via,Integer civico) throws  IndirizzoNullException, IsStringException, NotIntegerException{
		isString(citta);
		isString(via);
		isInt(civico);
		Indirizzo ind= indirizzoRepository.findByCittaAndViaAndCivico(citta,via,civico); 
		if(ind==null) {
			throw new IndirizzoNullException("L'indirizzo non esiste!", null);
		}	
		Integer idRemove=ind.getId();													
		indirizzoRepository.deleteById(idRemove);
	}

	private boolean isString(String s) throws IsStringException {
		if(s.isEmpty()||s.isBlank()) {
			throw new IsStringException("Non hai inserito una stringa valida!",null);
		}return true;
	}
	private boolean isInt(Integer i) throws NotIntegerException {
		if(i==null||!(i instanceof Integer)) {
			throw new NotIntegerException("Il campo non contiene un numero.",null);
		}
		return true;
	}
