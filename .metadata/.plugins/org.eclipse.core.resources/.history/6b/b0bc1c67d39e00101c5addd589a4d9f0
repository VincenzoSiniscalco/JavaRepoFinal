package it.itconsulting.ClassObject.model;

public class ContoCorrente {
	private String numeroConto;
	private float saldo;
	private Banca banca;

	public ContoCorrente(String nc,float saldo,Banca banca) {
		this.numeroConto=nc;
		this.saldo=saldo;
		this.banca=banca;
	}
	public String getNumeroConto() {

		return numeroConto;
	}

	public void setNumeroConto(String numeroConto) {
		this.numeroConto = numeroConto;
	}

	public float getSaldo() {
		return saldo;
	}

	public void setSaldo(float saldo) {
		this.saldo = saldo;
	}

	public Banca getBanca() {
		return banca;
	}

	public void setBanca(Banca banca) {
		this.banca = banca;
	}

	public String descrizione() {
		if(banca==null||numeroConto==null) {
			return null;
		}
		return numeroConto + " con saldo " + saldo + " aperto in " + banca.descrizione();
	}

	public String getNomeBanca() {
		if(banca.getNome()==null) {
			return null;
		}
		return banca.getNome();
	}

	public void setNomeBanca(String nome) {
		if(banca.getNome()!=null) {
			banca.setNome(nome);
		}

	}
	public String getCittaBanca() {
		if(banca==null || banca.getIndirizzo()==null) {
			return null;
		}else {
			return banca.getIndirizzo().getCitta();
		}
	}
	public void setCittaBanca(String citta) {
		if(banca!=null || banca.getIndirizzo()!=null) {

			banca.getIndirizzo().setCitta(citta);
		}
	}


